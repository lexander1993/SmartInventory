{
  "name": "inventory-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:seed": "node --import tsx src/seed.ts",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "db:reset:cleaning": "node --import tsx src/reset-cleaning.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0",
    "dotenv": "^17.2.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsx": "^4.20.5",
    "@types/node": "^24.3.0",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.15.5",
    "@electric-sql/pglite": "^0.3.14",
    "node-mocks-http": "^1.17.2"
  }
}
